#!/usr/bin/env bash
# dsk : Claude Code branche sur DeepSeek. Consomme 0 token de quota Anthropic.
#
#   dsk                      session interactive
#   dsk -p "brief"           headless : imprime le rapport final sur stdout
#   DSK_MODEL=... dsk -p     force un modele (dskf = le petit modele)
#
# Config isolee (~/.claude-dsk) : pas de plugins, pas de hooks, pas de memoire.
# C'est voulu : le builder recoit tout dans son brief, pas dans un system prompt
# de dizaines de milliers de tokens qu'il paierait a chaque tour.
set -uo pipefail

ENV_FILE="${ATELIER_ENV:-$HOME/.claude/atelier.env}"
[[ -r "$ENV_FILE" ]] || { echo "dsk: $ENV_FILE manquant, lance : atelier key" >&2; exit 1; }
# shellcheck disable=SC1090
source "$ENV_FILE"
: "${DEEPSEEK_API_KEY:?dsk: DEEPSEEK_API_KEY vide, lance : atelier key}"

MODEL="${DSK_MODEL:-${DSK_PRO_MODEL:-deepseek-v4-pro}}"
SMALL="${DSK_SMALL_MODEL:-deepseek-flash}"
# Alias utilises par les roles de `team` : la config choisit les vrais ids.
case "$MODEL" in
  pro)   MODEL="${DSK_PRO_MODEL:-deepseek-v4-pro}" ;;
  flash) MODEL="$SMALL" ;;
esac

export CLAUDE_CONFIG_DIR="${DSK_CONFIG_DIR:-$HOME/.claude-dsk}"
export ANTHROPIC_BASE_URL="${DSK_BASE_URL:-https://api.deepseek.com/anthropic}"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$SMALL"
export ANTHROPIC_SMALL_FAST_MODEL="$SMALL"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL"

# Une cle Anthropic residuelle serait preferee au token : elle doit disparaitre.
unset ANTHROPIC_API_KEY
export ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Le hook de session de l'Atelier ne doit pas s'injecter dans le builder.
export ATELIER_DISABLE=1

# Les ids DeepSeek sont absents du catalogue de Claude Code : sans ca, il suppose
# une autre fenetre et n'auto-compacte pas au bon moment.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${DSK_CONTEXT:-128000}"

# Headless : pas de stdin a attendre, et pas de prompt de permission a negocier
# (un agent headless ne sait pas y repondre et se bloque).
# Journal : un appel = une ligne dans metrics/dsk.jsonl (dskstats le resume). Une fois
# par jour, un instantane du solde part en arriere-plan pour mesurer la depense.
METRICS="${DSK_METRICS_DIR:-$HOME/.claude/metrics}"
journaliser() {
  local rc=$1 fin; fin=$(date +%s)
  mkdir -p "$METRICS" 2>/dev/null || return 0
  local dir="${PWD//\\/\\\\}"; dir="${dir//\"/\\\"}"
  printf '{"ts":"%s","model":"%s","mode":"%s","cwd":"%s","secondes":%d,"rc":%d}\n' \
    "$(date +%Y-%m-%dT%H:%M:%S)" "$MODEL" "$MODE" "$dir" $((fin - DEBUT)) "$rc" >> "$METRICS/dsk.jsonl"
  local jour; jour=$(date +%Y-%m-%d)
  if ! grep -q "\"$jour\"" "$METRICS/dsk-solde.jsonl" 2>/dev/null; then
    ( s=$(curl -fsS --max-time 8 https://api.deepseek.com/user/balance \
          -H "Authorization: Bearer $DEEPSEEK_API_KEY" 2>/dev/null |
          python3 -c 'import sys,json; print(json.load(sys.stdin)["balance_infos"][0]["total_balance"])' 2>/dev/null) \
      && [[ -n "$s" ]] && printf '{"date":"%s","solde":%s}\n' "$jour" "$s" >> "$METRICS/dsk-solde.jsonl" ) \
      >/dev/null 2>&1 &
  fi
}
# Releve : ce que dsk a VRAIMENT change, calcule par git et non tire de son rapport.
# Une photo de tout l'arbre (suivis + non suivis, hors .gitignore) avant et apres,
# dans un index temporaire : l'index et le staging de l'utilisateur ne bougent pas.
# Tout ce qui change pendant l'appel y figure, y compris une modif faite a la main
# en parallele. DSK_RELEVE=0 le coupe (team le coupe : ses agents tournent en parallele).
RACINE=""; GITDIR=""; AVANT=""
photo() {
  local idx; idx="$(mktemp)" || return 1
  cp "$GITDIR/index" "$idx" 2>/dev/null || rm -f "$idx"  # copie = cache de stat, bien plus rapide
  GIT_INDEX_FILE="$idx" git -C "$RACINE" add -A . >/dev/null 2>&1 &&
    GIT_INDEX_FILE="$idx" git -C "$RACINE" write-tree 2>/dev/null
  rm -f "$idx"
}
releve() {
  if [[ -z "$RACINE" ]]; then
    echo "RELEVE: pas de depot git ici, aucun releve : verifie les fichiers toi-meme"; return
  fi
  local apres; apres="$(photo)"
  if [[ -z "$AVANT" || -z "$apres" ]]; then echo "RELEVE: photo git impossible, aucun releve"; return; fi
  if [[ "$AVANT" == "$apres" ]]; then echo "RELEVE: aucun fichier modifie par dsk"; return; fi
  local dir="$METRICS/dsk-releves" max="${DSK_RELEVE_LIGNES:-400}" f n lignes
  mkdir -p "$dir"
  f="$dir/$(date +%Y%m%d-%H%M%S)-$$.diff"
  git -C "$RACINE" diff --no-color "$AVANT" "$apres" > "$f"
  n="$(git -C "$RACINE" diff --name-only "$AVANT" "$apres" | wc -l | tr -d ' ')"
  lignes="$(wc -l < "$f" | tr -d ' ')"
  printf '\n=== Releve dsk : le diff reel de cet appel (git), c est lui qui fait foi ===\n'
  git -C "$RACINE" diff --stat=100 "$AVANT" "$apres" | tail -n 40
  echo
  head -n "$max" "$f"
  (( lignes > max )) && echo "... diff tronque ($lignes lignes) : lis $f"
  echo "RELEVE: $n fichier(s) modifie(s) par dsk ; diff complet : $f"
}

DEBUT=$(date +%s)
if [[ " $* " == *" -p "* || " $* " == *" --print "* ]]; then
  MODE=headless
  if [[ " $* " != *"--permission-mode"* && " $* " != *"--dangerously-skip-permissions"* ]]; then
    set -- "$@" --permission-mode bypassPermissions
  fi
  if [[ "${DSK_RELEVE:-1}" != "0" ]] && RACINE="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    GITDIR="$(git rev-parse --absolute-git-dir 2>/dev/null)"
    AVANT="$(photo)"
  else
    RACINE=""
  fi
  claude "$@" < /dev/null; rc=$?
  [[ "${DSK_RELEVE:-1}" != "0" ]] && releve
else
  MODE=interactif
  claude "$@"; rc=$?
fi
journaliser "$rc"
exit "$rc"
